# ==============================================================================
# Flask Backend Configuration
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Flask Environment mode: development | production (default: development)
FLASK_ENV=development

# Flask session signing secret key (REQUIRED for production deployment)
SECRET_KEY=your-secret-key-here

# MongoDB connection URI (default: mongodb://localhost:27017/parcel_routing_db)
MONGO_URI=mongodb://localhost:27017/parcel_routing_db

# Secret key required for Admin account registration (REQUIRED for Admin registration)
ADMIN_REGISTRATION_KEY=your-admin-registration-key-here

# Comma-separated CORS allowed origins (default: http://localhost:5173,http://127.0.0.1:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure session cookies flag: True | False (auto-defaults to True if FLASK_ENV=production)
SESSION_COOKIE_SECURE=False

# Maximum allowable batch XML/JSON upload size in bytes (default: 2097152 = 2 MB)
MAX_BATCH_FILE_SIZE_BYTES=2097152

# ==============================================================================
# Frontend Configuration
# ==============================================================================

# Backend API Base URL (leave empty in development to use Vite proxy, set in production e.g. https://your-backend.onrender.com/api)
VITE_API_BASE_URL=
